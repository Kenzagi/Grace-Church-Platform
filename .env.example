# ── Grace Community Church — Environment Variables ──────────────────────
# Copy this file to .env.local and fill in each value.
# Vercel: set these in Project Settings > Environment Variables.

# PostgreSQL connection string
# Vercel Postgres example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Supabase example:   postgresql://postgres:[YOUR-PASSWORD]@db.xxx.supabase.co:5432/postgres
# Neon example:       postgresql://neondb_owner:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/grace_church?schema=public"

# HMAC secret for session cookies — GENERATE A NEW ONE
# Run: openssl rand -base64 48
SESSION_SECRET=""

# Optional: Vercel Postgres provides these automatically.
# If using Neon/Supabase, you may need to set them for direct connections.
# DIRECT_URL="postgresql://user:password@localhost:5432/grace_church?schema=public"

# Optional: Override Org ID (auto-generated on first seed if absent)
# ORG_ID=""
